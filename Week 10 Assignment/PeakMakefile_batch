# Batch peak calling (MACS3) driven by a design file.
#
#   design.csv --> SRR download --> parallel bwa alignment --> MACS3 peaks
#                                                     (treatment vs. background)
#
# The design file is a CSV with a header row. Required columns (any order,
# case-insensitive):
#     sample    unique sample name; becomes the BAM name and the MACS3 -n name
#     srr       SRA run accession (SRR / ERR / DRR)
# Optional columns:
#     control   name of ANOTHER row in this file to use as the background
#               (input / IgG / mock) for this sample. Empty, NA or none = call
#               peaks without a background. (also accepted: background, input)
#     reads     download only the first <reads> reads of that accession
#               (also accepted: n, nreads, max_reads). Empty = use N=, else all.
# Any extra columns (group, antibody, date, ...) are metadata and are ignored.
#
# Example design.csv:
#     sample,srr,control,reads
#     input1,SRR0000001,,
#     chip1,SRR0000002,input1,
#     chip2,SRR0000003,input1,5000000
#
# A row that is named in the control column of another row is a BACKGROUND
# sample. Backgrounds are downloaded and aligned automatically whenever a
# sample that needs them is run, but peaks are not called on them (unless you
# name them in ONLY=).
#
# Usage (most common):
#   make -f PeakMakefile_batch all        REF=fasta/genome.fa                 # ONE sample (first non-background row)
#   make -f PeakMakefile_batch all        REF=fasta/genome.fa SAMPLE=chip2    # one chosen sample (+ its background)
#   make -f PeakMakefile_batch batch      REF=fasta/genome.fa                 # ALL samples, in parallel
#   make -f PeakMakefile_batch background REF=fasta/genome.fa                 # only the background samples
#   make -f PeakMakefile_batch batch      REF=fasta/genome.fa ONLY="chip1 chip2"   # any subset
#   make -f PeakMakefile_batch batch      REF=fasta/genome.fa USECTRL=0       # ignore the control column
#
# "all" is the default target, so "make -f PeakMakefile_batch REF=..." also works.
# To avoid typing REF every time: export REF=fasta/genome.fa (or edit "REF ?=" below).
#
# "batch" REDOES EVERY STEP from scratch by default: it first deletes the old
# FASTQ files, reference indexes, BAMs and peak files of the samples it will run,
# then rebuilds them. To keep (and reuse) earlier results say so explicitly:
#   SKIP="fetch"              reuse the downloaded reads
#   SKIP="index"              reuse the reference indexes
#   SKIP="align"              reuse the BAMs
#   SKIP="fetch index align"  reuse everything; only the peaks are redone
#   RESUME=1                  same as SKIP="fetch index align"
# Tip: run "background" once, then "batch ... SKIP='fetch index'" or RESUME=1
# style runs so a shared background is not realigned for every sample.
# Note: make still rebuilds anything whose inputs are newer. For example, if you
# redo the index but skip align, the BAMs are rebuilt anyway because they depend
# on the index.
#
# Steps run by "batch" (each one is also a target you can run on its own):
#   tools    check that all programs are installed
#   design   validate design.csv (names, accessions, controls, duplicates)
#   index    index the reference once (bwa + samtools faidx)
#   fetch    download reads with fastq-dump, DL_JOBS samples at a time
#   align    GNU Parallel: one bwa mem | filter | sort job per sample
#   peaks    GNU Parallel: one macs3 callpeak job per sample (vs. its control)
#
# Other targets: help, prep, background, fresh, refcheck, summary, igv, clean,
#                clean-peaks, clean-reads, clean-bam
#
# Parameters (defaults in brackets):
#   REF=<fasta>      reference genome (required, never downloaded or overwritten)
#   DESIGN=design.csv
#   ONLY="s1 s2"     run only these samples (their backgrounds come along)
#   SAMPLE=<name>    sample used by "all" [first non-background row]
#   USECTRL=1        use the control column (0 = call every sample without background)
#   MODE=narrow      narrow (TF, ATAC, H3K4me3...) or broad (H3K27me3, H3K36me3...)
#   QVAL=0.05        MACS3 -q cutoff
#   BROAD_QVAL=0.1   MACS3 --broad-cutoff (MODE=broad only)
#   GSIZE=           MACS3 -g (hs, mm, ce, dm or a number) [sum of REF contig lengths]
#   FORMAT=AUTO      MACS3 -f: AUTO (detect single/paired-end), BAM or BAMPE
#   EXTRA=           extra MACS3 arguments, e.g. EXTRA="--nomodel --extsize 200"
#                    (ATAC-seq: EXTRA="--nomodel --shift -100 --extsize 200")
#   MAPQ=10          minimum mapping quality kept in the BAMs
#   PEAKDIR=peaks    directory for MACS3 output
#   JOBS=<number of samples>   alignment jobs run at the same time
#   PJOBS=<min(CORES, samples to call)>   MACS3 jobs run at the same time
#   DL_JOBS=4                  simultaneous downloads (be polite to NCBI)
#   CORES=<SLURM_CPUS_PER_TASK, else detected>   total cores available
#   THREADS=CORES/JOBS         threads given to each alignment job
#   OUTDIR=fastq               directory for the downloaded FASTQ files
#   PREFIX / N=                N = optional default: first N reads of every run
#                              (the design file's reads column wins per sample)
#
# On a SLURM cluster, ask for enough cores and run inside the allocation, e.g.
#   sbatch -c 20 --mem=64G --wrap "make -f PeakMakefile_batch batch REF=fasta/genome.fa"
# 10 samples on 20 cores -> 10 parallel jobs with 2 threads each.
#
# Running a single step on its own (make fetch / align / peaks) behaves like
# normal make and skips work that is already done; run "make fresh" first, or
# add -B, to force it. Only "batch" and "background" start from scratch
# automatically.

SHELL = bash
.SHELLFLAGS = -euo pipefail -c
.DELETE_ON_ERROR:
# Keep BAMs and other files made through chained pattern rules.
.SECONDARY:

# Path of this Makefile, used when GNU Parallel calls make for each sample.
MAKEFILE := $(firstword ${MAKEFILE_LIST})

# Required: path to the reference FASTA.
REF ?=

# Design file.
DESIGN ?= design.csv

# Run only these samples from the design file (empty = all). "make all" sets it
# to one sample: SAMPLE=<name>, default the first non-background row.
ONLY ?=
SAMPLE ?=

# Use the control (background) column of the design file (1 = yes, 0 = no).
USECTRL ?= 1

# MACS3 settings.
MODE ?= narrow
QVAL ?= 0.05
BROAD_QVAL ?= 0.1
GSIZE ?=
FORMAT ?= AUTO
EXTRA ?=
PEAKDIR ?= peaks
ifeq ($(filter ${MODE},narrow broad),)
$(error MODE must be narrow or broad)
endif
ifeq ($(filter ${FORMAT},AUTO BAM BAMPE),)
$(error FORMAT must be AUTO, BAM or BAMPE)
endif
PEAKEXT := $(if $(filter broad,${MODE}),broadPeak,narrowPeak)

# Minimum mapping quality kept in the BAMs (also drops unmapped, secondary and
# supplementary alignments).
MAPQ ?= 10

# Simultaneous downloads.
DL_JOBS ?= 4

# Steps to KEEP instead of redoing (any of: fetch index align). RESUME=1 keeps all three.
SKIP ?=
RESUME ?= 0
SKIPPED := $(sort ${SKIP} $(if $(filter 1,${RESUME}),fetch index align))
ifneq ($(filter-out fetch index align,${SKIPPED}),)
$(error Unknown step in SKIP: $(filter-out fetch index align,${SKIPPED}). Use any of: fetch index align)
endif
DO_FETCH := $(if $(filter fetch,${SKIPPED}),0,1)
DO_INDEX := $(if $(filter index,${SKIPPED}),0,1)
DO_ALIGN := $(if $(filter align,${SKIPPED}),0,1)

# Directory for the downloaded FASTQ files.
OUTDIR ?= fastq

# Optional: only the first N reads of every run (empty = whole run).
N ?=

HASH := \#

# ---------------------------------------------------------------------------
# Read the design file: SAMPLE:SRR:READS:CONTROL entries (header-aware, ignores
# comments, blank lines, quotes and Windows line endings). Empty READS or
# CONTROL fields are written as "-" so that the fields keep their position.
# ---------------------------------------------------------------------------
ifneq ($(wildcard ${DESIGN}),)
PAIRS_ALL := $(shell sed '1s/^\xEF\xBB\xBF//' ${DESIGN} | awk -F, 'NR==1{for(i=1;i<=NF;i++){h=tolower($$i);gsub(/[ "\r]/,"",h);if(h=="sample")s=i;if(h=="srr"||h=="run"||h=="accession")r=i;if(h=="reads"||h=="n"||h=="nreads"||h=="max_reads")n=i;if(h=="control"||h=="background"||h=="input")c=i};next} /^[ \t]*($(HASH)|$$)/{next} {gsub(/[ "\r]/,"");cc=(c?$$c:"");if(tolower(cc)~/^(na|none|\.)$$/)cc="";print $$s":"$$r":"(n&&$$n!=""?$$n:"-")":"(cc!=""?cc:"-")}')
endif

# field(entry,number): one field of a SAMPLE:SRR:READS:CONTROL entry.
field = $(word $2,$(subst :, ,$1))
# ctrl_of(sample): its control name, or "-" when it has none.
ctrl_of = $(call field,$(filter $1:%,${PAIRS_ALL}),4)

ALL_NAMES := $(foreach p,${PAIRS_ALL},$(call field,$p,1))

# Background samples: every name used in the control column.
BGSET := $(sort $(filter-out -,$(foreach p,${PAIRS_ALL},$(call field,$p,4))))

# Samples to call peaks on: ONLY, else every sample that is not a background.
CALLABLE := $(filter-out ${BGSET},${ALL_NAMES})
CALLS := $(if $(strip ${ONLY}),$(filter ${ONLY},${ALL_NAMES}),${CALLABLE})
NCALLS := $(words ${CALLS})

# Backgrounds that the chosen samples need.
NEEDED_CTRLS := $(if $(filter 1,${USECTRL}),$(sort $(filter-out -,$(foreach s,${CALLS},$(call ctrl_of,$s)))))

# Samples to download and align: the chosen samples plus their backgrounds.
SAMPLES := $(sort ${CALLS} ${NEEDED_CTRLS})
NSAMPLES := $(words ${SAMPLES})
PAIRS := $(foreach s,${SAMPLES},$(filter $s:%,${PAIRS_ALL}))

# Sample used by "all".
FIRST := $(firstword ${CALLABLE} ${ALL_NAMES})

# Resources: how many alignments at once and how many threads each gets.
JOBS ?= $(if $(filter 0,${NSAMPLES}),1,${NSAMPLES})
# nproc is missing on some systems (e.g. macOS), so fall back to getconf, then
# sysctl, then 1. Set CORES=<n> on the command line to override.
CORES ?= $(if ${SLURM_CPUS_PER_TASK},${SLURM_CPUS_PER_TASK},$(shell nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1))
THREADS ?= $(shell t=$$(( ${CORES} / ${JOBS} )); echo $$(( t < 1 ? 1 : t )))
# MACS3 is single-threaded: one job per sample, at most one per core.
PJOBS ?= $(shell n=${NCALLS}; c=${CORES}; m=$$(( n < c ? n : c )); echo $$(( m < 1 ? 1 : m )))

# Short name of the reference, taken from the file name.
REFNAME = $(basename $(notdir ${REF}))

# One BAM per sample and one peak file per sample that is called.
BAMS ?= $(addprefix bam/,$(addsuffix .bam,${SAMPLES}))
BAIS = $(addsuffix .bai,${BAMS})
PEAKFILES = $(addprefix ${PEAKDIR}/,$(addsuffix _peaks.${PEAKEXT},${CALLS}))

# Per-sample variables and dependencies, generated from the design file.
#   $(1) sample  $(2) SRR  $(3) reads ("-" = none)  $(4) control ("-" = none)
CTRLFOR = $(and $(filter 1,${USECTRL}),$(filter-out -,$(1)))
define SAMPLE_RULES
${OUTDIR}/$(1).fetched: SRR=$(2)
${OUTDIR}/$(1).fetched: NREADS=$(patsubst -,,$(3))
bam/$(1).bam: SRR=$(2)
${PEAKDIR}/$(1)_peaks.${PEAKEXT}: CTRL=$(call CTRLFOR,$(4))
${PEAKDIR}/$(1)_peaks.${PEAKEXT}: $(if $(call CTRLFOR,$(4)),bam/$(4).bam)
endef
$(foreach p,${PAIRS_ALL},$(eval $(call SAMPLE_RULES,$(call field,$p,1),$(call field,$p,2),$(call field,$p,3),$(call field,$p,4))))

.DEFAULT_GOAL := all
.PHONY: all help batch background prep fresh tools design index fetch align peaks refcheck summary igv clean clean-peaks clean-reads clean-bam

# Print usage.
help:
	@echo "Usage:"
	@echo "  make -f ${MAKEFILE} all        REF=<reference.fa>   one sample (first non-background in ${DESIGN}, or SAMPLE=<name>)"
	@echo "  make -f ${MAKEFILE} batch      REF=<reference.fa>   all samples in parallel (ONLY=\"a b\" for a subset)"
	@echo "  make -f ${MAKEFILE} background REF=<reference.fa>   only the background (control) samples"
	@echo
	@echo "  Steps: tools design index fetch align peaks   (batch runs them all)"
	@echo "  batch redoes every step; keep earlier results with SKIP=\"fetch index align\" or RESUME=1"
	@echo "  Other: prep fresh refcheck summary igv clean clean-peaks clean-reads clean-bam"
	@echo "  Optional: JOBS=${JOBS} PJOBS=${PJOBS} DL_JOBS=${DL_JOBS} CORES=${CORES} THREADS=${THREADS}"
	@echo "            MODE=${MODE} QVAL=${QVAL} FORMAT=${FORMAT} GSIZE=${GSIZE} USECTRL=${USECTRL}"
	@echo "            MAPQ=${MAPQ} PEAKDIR=${PEAKDIR} OUTDIR=${OUTDIR} N=${N} EXTRA=\"${EXTRA}\""
	@echo

# ---------------------------------------------------------------------------
# Early argument checks (only for goals that need them).
# ---------------------------------------------------------------------------
GOALS := $(or ${MAKECMDGOALS},all)
NEED_DESIGN = all batch background prep fresh design fetch align peaks refcheck summary igv ${OUTDIR}/% bam/% ${PEAKDIR}/%
NEED_REF = all batch background prep fresh index align peaks refcheck igv bam/% ${PEAKDIR}/%

ifneq ($(filter ${NEED_DESIGN},${GOALS}),)
ifeq ($(wildcard ${DESIGN}),)
$(error Design file ${DESIGN} not found. Pass DESIGN=<file.csv>)
endif
ifneq ($(filter-out design,${GOALS}),)
ifeq ($(strip ${ALL_NAMES}),)
$(error No samples found in ${DESIGN}. It needs a header with sample and srr columns)
endif
ifneq ($(strip $(filter-out ${ALL_NAMES},${ONLY})),)
$(error Not in ${DESIGN}: ONLY="$(filter-out ${ALL_NAMES},${ONLY})". Check the sample names)
endif
ifeq ($(strip ${CALLS}),)
$(error No samples to run: every row in ${DESIGN} is a background. Use ONLY=<name> to run one anyway)
endif
endif
endif

ifneq ($(filter ${NEED_REF},${GOALS}),)
ifeq ($(strip ${REF}),)
$(error REF is not set. Pass REF=<reference.fa>)
endif
ifeq ($(wildcard ${REF}),)
$(error Reference ${REF} not found. This Makefile never downloads references)
endif
endif

# Check that the GNU make version is 4 or higher.
MAKE_MAJOR := $(firstword $(subst ., ,$(MAKE_VERSION)))
ifneq ($(firstword $(sort 4 $(MAKE_MAJOR))),4)
    $(info $(HASH) This Makefile needs make version 4 or higher.)
    $(info $(HASH) Activate the bioinfo environment.)
    $(error Stop.)
endif

# ---------------------------------------------------------------------------
# The whole workflow.
# ---------------------------------------------------------------------------
# One sample: the first non-background row of the design file, or SAMPLE=<name>.
# Its background (if any) is downloaded and aligned too.
all:
	@echo "== single-sample run: $(or ${SAMPLE},${FIRST}) (use 'batch' for all ${NCALLS} samples) =="
	$(MAKE) -f ${MAKEFILE} --no-print-directory batch ONLY=$(or ${SAMPLE},${FIRST})

# All samples in the design file (or the subset named in ONLY).
batch: prep
	$(MAKE) -f ${MAKEFILE} --no-print-directory refcheck
	$(MAKE) -f ${MAKEFILE} --no-print-directory peaks
	$(MAKE) -f ${MAKEFILE} --no-print-directory summary

# Only the background (control) samples: download and align them.
background: tools design
	@test -n "${BGSET}" || { echo "ERROR: no background samples (control column) in ${DESIGN}"; exit 1; }
	@echo "== background samples: ${BGSET} =="
	$(MAKE) -f ${MAKEFILE} --no-print-directory prep ONLY="${BGSET}" USECTRL=0

# Everything up to and including the alignments.
prep: tools design
	$(MAKE) -f ${MAKEFILE} --no-print-directory fresh
	@echo "== ${NCALLS} sample(s) to call + background(s) ${NEEDED_CTRLS}: ${NSAMPLES} samples, ${JOBS} parallel alignments x ${THREADS} threads =="
	$(MAKE) -f ${MAKEFILE} --no-print-directory index
	$(MAKE) -f ${MAKEFILE} --no-print-directory fetch
	$(MAKE) -f ${MAKEFILE} --no-print-directory align

# Delete the old results of every step that is not listed in SKIP, so that
# "batch" starts from scratch. The peaks are always redone.
fresh:
	@echo "Redoing: $(if $(filter 1,${DO_FETCH}),fetch )$(if $(filter 1,${DO_INDEX}),index )$(if $(filter 1,${DO_ALIGN}),align )peaks"
	@echo "Keeping: $(if ${SKIPPED},${SKIPPED},nothing)"
	@if [ "${DO_FETCH}" = 1 ]; then \
	    for p in ${PAIRS}; do \
	        s=$${p%%:*}; r=$${p#*:}; r=$${r%%:*}; \
	        rm -f ${OUTDIR}/$${s}.fetched ${OUTDIR}/$${r}.fastq.gz ${OUTDIR}/$${r}_1.fastq.gz ${OUTDIR}/$${r}_2.fastq.gz; \
	    done; \
	fi
	@if [ "${DO_INDEX}" = 1 ]; then \
	    rm -f ${REF}.fai ${REF}.amb ${REF}.ann ${REF}.bwt ${REF}.pac ${REF}.sa; \
	fi
	@if [ "${DO_ALIGN}" = 1 ]; then \
	    rm -f ${BAMS} ${BAIS} bam/*.part bam/*.sorttmp.* $(addprefix logs/,$(addsuffix .flagstat.txt,${SAMPLES})); \
	fi
	@for s in ${CALLS}; do \
	    for suf in _peaks.narrowPeak _peaks.broadPeak _peaks.xls _peaks.gappedPeak _summits.bed _model.r _treat_pileup.bdg _control_lambda.bdg; do \
	        rm -f ${PEAKDIR}/$${s}$${suf}; \
	    done; \
	done

# Check that required executables exist.
tools:
	@for t in samtools bwa parallel fastq-dump macs3; do \
	    command -v $$t >/dev/null || { echo "ERROR: $$t not found. Activate the bioinfo environment."; missing=1; }; \
	done; [ -z "$${missing:-}" ]

# Validate the design file and show what will be run.
design:
	@test -n "${PAIRS_ALL}" || { echo "ERROR: no samples read from ${DESIGN}"; exit 1; }
	@for col in sample srr; do \
	    head -n1 ${DESIGN} | sed '1s/^\xEF\xBB\xBF//' | tr -d '\r" ' | tr 'A-Z' 'a-z' | tr ',' '\n' | grep -qxE "$$col|$${col/srr/run}|$${col/srr/accession}" \
	    || { echo "ERROR: ${DESIGN} has no '$$col' column in its header"; exit 1; }; \
	done
	@printf '%s\n' ${PAIRS_ALL} | awk -F: '\
	    { name[NR]=$$1; srr[NR]=$$2; rd[NR]=$$3; ct[NR]=$$4; isname[$$1]=1; \
	      if($$3 != "-" && $$3 !~ /^[1-9][0-9]*$$/){print "ERROR: bad reads for "$$1": "$$3 > "/dev/stderr"; bad=1} \
	      if($$1 !~ /^[A-Za-z0-9_.-]+$$/ || $$1 == "-"){print "ERROR: bad sample name: "$$1 > "/dev/stderr"; bad=1} \
	      if($$2 !~ /^[SED]RR[0-9]+$$/){print "ERROR: bad SRR for "$$1": "$$2 > "/dev/stderr"; bad=1} \
	      if(sn[$$1]++){print "ERROR: duplicate sample: "$$1 > "/dev/stderr"; bad=1} \
	      if(sr[$$2]++){print "ERROR: duplicate SRR: "$$2 > "/dev/stderr"; bad=1} } \
	    END{ for(i=1;i<=NR;i++){ if(ct[i]!="-"){ \
	             if(!(ct[i] in isname)){print "ERROR: control of "name[i]" is not a sample in the design file: "ct[i] > "/dev/stderr"; bad=1} \
	             if(ct[i]==name[i]){print "ERROR: "name[i]" is its own control" > "/dev/stderr"; bad=1} \
	             used[ct[i]]=1 } } \
	         print "Sample\tSRR\tReads\tControl\tRole"; \
	         for(i=1;i<=NR;i++) print name[i]"\t"srr[i]"\t"(rd[i]=="-"?"${N}":rd[i])"\t"(ct[i]=="-"?"":ct[i])"\t"((name[i] in used)?"background":"treatment"); \
	         print NR" samples"; exit bad }'

# ---------------------------------------------------------------------------
# Reference indexes (built once, before any parallel work starts).
# ---------------------------------------------------------------------------
ifneq ($(strip ${REF}),)
${REF}.fai: ${REF}
	samtools faidx ${REF}

${REF}.bwt: ${REF}
	bwa index ${REF}
endif

index: ${REF}.fai ${REF}.bwt

# ---------------------------------------------------------------------------
# Download: DL_JOBS samples at a time.
# ---------------------------------------------------------------------------
fetch: design
	mkdir -p logs
	parallel --halt now,fail=1 --tag --line-buffer -j ${DL_JOBS} --joblog logs/fetch.joblog \
	    '$(MAKE) -f ${MAKEFILE} --no-print-directory ${OUTDIR}/{}.fetched' ::: ${SAMPLES}

# One sample: SRR -> FASTQ (gzipped). The stamp file marks a finished download.
# Reads per accession: the design file's reads column, else N=, else the whole run.
${OUTDIR}/%.fetched:
	@set -eu; \
	if [ -z "${SRR}" ]; then \
		echo "Error: no SRR known for sample $*."; \
		exit 1; \
	fi; \
	if [ -n "$(or ${NREADS},${N})" ]; then \
		case "$(or ${NREADS},${N})" in \
			*[!0-9]*|0) echo "Error: reads (or N) must be a positive integer."; exit 1 ;; \
		esac; \
	fi; \
	command -v fastq-dump >/dev/null 2>&1 || { \
		echo "Error: fastq-dump was not found."; \
		echo "Install the NCBI SRA Toolkit first."; \
		exit 1; \
	}; \
	mkdir -p "${OUTDIR}" logs; \
	echo "[$*] downloading ${SRR} $(if $(or ${NREADS},${N}),(first $(or ${NREADS},${N}) reads))"; \
	fastq-dump $(if $(or ${NREADS},${N}),-X "$(or ${NREADS},${N})") \
		--outdir "${OUTDIR}" \
		--split-files \
		--gzip \
		"${SRR}"; \
	test -s "${OUTDIR}/${SRR}_1.fastq.gz" || { \
		echo "Error: no FASTQ produced for ${SRR}."; \
		exit 1; \
	}; \
	touch $@

# ---------------------------------------------------------------------------
# Alignment: ALL samples (treatments and backgrounds) at once with GNU Parallel.
# ---------------------------------------------------------------------------
align: design index
	mkdir -p logs
	parallel --halt now,fail=1 --tag --line-buffer -j ${JOBS} --joblog logs/align.joblog \
	    '$(MAKE) -f ${MAKEFILE} --no-print-directory bam/{}.bam' ::: ${SAMPLES}

# One sample: reads -> filtered, sorted, indexed BAM. Paired-end is detected
# automatically. Unmapped, secondary and supplementary alignments and reads
# with MAPQ < ${MAPQ} are removed. Duplicates are left for MACS3 to handle
# (its default --keep-dup auto).
bam/%.bam: ${OUTDIR}/%.fetched ${REF}.bwt ${REF}.fai
	mkdir -p bam logs
	r1=${OUTDIR}/${SRR}_1.fastq.gz; r2=${OUTDIR}/${SRR}_2.fastq.gz; \
	if [ -s $$r1 ] && [ -s $$r2 ]; then fq="$$r1 $$r2"; else fq=$$r1; fi; \
	echo "[$*] aligning: $$fq"; \
	bwa mem -t ${THREADS} -R '@RG\tID:$*\tSM:$*\tLB:$*\tPL:ILLUMINA' ${REF} $$fq | \
	    samtools view -u -F 2308 -q ${MAPQ} - | \
	    samtools sort -@ ${THREADS} -T bam/$*.sorttmp -O bam -o $@.part -
	mv $@.part $@
	samtools index -@ ${THREADS} $@
	samtools flagstat $@ > logs/$*.flagstat.txt

# BAM index (for BAMs supplied through BAMS=).
%.bam.bai: %.bam
	samtools index -@ ${THREADS} $<

# Stop early if any BAM was aligned to a different reference than REF (for
# example BAMs left over from an earlier run with another reference).
refcheck:
	@for b in ${BAMS}; do \
	    bad=$$(comm -13 <(cut -f1 ${REF}.fai | sort -u) <(samtools view -H $$b | awk '$$1=="@SQ"{sub(/^SN:/,"",$$2); print $$2}' | sort -u)); \
	    if [ -n "$$bad" ]; then \
	        echo "ERROR: $$b was aligned to a different reference than ${REF}."; \
	        echo "       Contigs in the BAM but not in the reference, e.g.: $$(echo "$$bad" | head -3 | paste -sd' ' -)"; \
	        echo "       Remove the old reference indexes and BAMs, then rerun:"; \
	        echo "         rm -f ${REF}.fai ${REF}.amb ${REF}.ann ${REF}.bwt ${REF}.pac ${REF}.sa"; \
	        echo "         make -f ${MAKEFILE} clean-bam"; \
	        exit 1; \
	    fi; \
	done; echo "OK: all BAMs match the reference contigs."

# ---------------------------------------------------------------------------
# Peak calling: one MACS3 job per sample, GNU Parallel, each against its own
# background when the design file names one (and USECTRL=1).
# ---------------------------------------------------------------------------
peaks: design index
	mkdir -p logs ${PEAKDIR}
	parallel --halt now,fail=1 --tag --line-buffer -j ${PJOBS} --joblog logs/peaks.joblog \
	    '$(MAKE) -f ${MAKEFILE} --no-print-directory ${PEAKDIR}/{}_peaks.${PEAKEXT}' ::: ${CALLS}

# One sample. CTRL (set per sample from the design file) is the background.
# The treatment BAM and, when there is one, the control BAM are prerequisites
# (see SAMPLE_RULES), so they are built first if missing.
# FORMAT=AUTO uses BAMPE when the BAM contains paired reads, otherwise BAM.
${PEAKDIR}/%_peaks.${PEAKEXT}: bam/%.bam ${REF}.fai
	mkdir -p ${PEAKDIR} logs
	g="${GSIZE}"; [ -n "$$g" ] || g=$$(awk '{s+=$$2} END{print s}' ${REF}.fai); \
	fmt="${FORMAT}"; \
	if [ "$$fmt" = AUTO ]; then \
	    if samtools flagstat bam/$*.bam | awk '/paired in sequencing/{p=$$1} END{exit !(p>0)}'; then fmt=BAMPE; else fmt=BAM; fi; \
	fi; \
	echo "[$*] macs3 callpeak: treatment=bam/$*.bam control=$(if ${CTRL},bam/${CTRL}.bam,none) format=$$fmt genome size=$$g mode=${MODE}"; \
	macs3 callpeak -t bam/$*.bam $(if ${CTRL},-c bam/${CTRL}.bam) \
	    -f $$fmt -g $$g -n $* --outdir ${PEAKDIR} -q ${QVAL} \
	    $(if $(filter broad,${MODE}),--broad --broad-cutoff ${BROAD_QVAL}) ${EXTRA} \
	    2> logs/$*.macs3.log
	test -s $@ || echo "[$*] note: no peaks found (see logs/$*.macs3.log)"
	@touch $@

# Number of peaks per sample and the background used.
summary:
	@printf "Sample\tControl\tPeaks\tFile\n"; \
	for s in ${CALLS}; do \
	    f=${PEAKDIR}/$${s}_peaks.${PEAKEXT}; \
	    c=$$(echo "${PAIRS_ALL}" | tr ' ' '\n' | awk -F: -v s=$$s '$$1==s{print ($$4=="-"?"none":$$4)}'); \
	    [ "${USECTRL}" = 1 ] || c=none; \
	    if [ -e $$f ]; then n=$$(wc -l < $$f); else n=NA; fi; \
	    printf "%s\t%s\t%s\t%s\n" "$$s" "$$c" "$$n" "$$f"; \
	done

# ---------------------------------------------------------------------------
# Cleaning.
# ---------------------------------------------------------------------------
# Removes the MACS3 output only. Reference, reads and BAMs are kept.
clean clean-peaks:
	rm -rf "${PEAKDIR}"

# Removes downloaded reads and their stamp files (BAMs are kept).
clean-reads:
	rm -rf "${OUTDIR}"

# Removes BAMs, their indexes and alignment logs.
clean-bam:
	rm -rf bam logs

# ---------------------------------------------------------------------------
# Automating IGV visualization (IGV must be running with port 60151 enabled).
# ---------------------------------------------------------------------------
IGV = nc localhost 60151
PWD = $(shell pwd)
igv:
	echo "new" | ${IGV}
	echo "genome ${PWD}/${REF}" | ${IGV}
	for b in ${BAMS}; do echo "load ${PWD}/$$b" | ${IGV}; done
	for f in ${PEAKFILES}; do echo "load ${PWD}/$$f" | ${IGV}; done
